# Copy to .env and adjust. .env is gitignored - never commit credentials.

# ---- MCP server ----
MCP_PORT=3001
# SQLite file holding all long-term household state (gitignored)
UNRUSH_DB_PATH=./data/unrush.db
# Optional: pretend "now" is this local time so the demo works at any hour.
# "HH:MM" (today) or "YYYY-MM-DDTHH:MM". The clock keeps ticking from there.
# Recommended for recording: UNRUSH_NOW=15:00
# UNRUSH_NOW=15:00

# ---- Web backend / agent ----
WEB_PORT=3000
MCP_SERVER_URL=http://localhost:3001/mcp
HOUSEHOLD_ID=demo-household
# Conversation turns kept per browser session (long-term memory lives in the MCP server)
HISTORY_TURNS=8
# How often the backend polls get_alerts, in ms
ALERT_POLL_MS=3000

# ---- Amazon Bedrock ----
# Credentials come ONLY from the default AWS credential chain
# (aws configure / aws sso login / AWS_PROFILE / env vars / IAM role). Never put keys in this file.
AWS_REGION=us-east-1
# Required. A model ID or inference profile ID that is ENABLED in your account + region and supports tool use.
# Check the Bedrock console → Model access / Cross-region inference. Small, cheap suggestions:
#   us.amazon.nova-2-lite-v1:0      (recommended: cheap, fast, best multi-step tool use + spoken style in our tests)
#   us.amazon.nova-lite-v1:0        (cheapest; works, but tends to answer in lists)
#   us.amazon.nova-pro-v1:0         (stronger, pricier)
BEDROCK_MODEL_ID=
# Ceiling per model call (billed on actual tokens used)
BEDROCK_MAX_TOKENS=1024

# Optional: Amazon Bedrock AgentCore Memory for conversation + household preferences.
# Create it with `npm run agentcore:setup`, then paste the printed id here.
# AGENTCORE_MEMORY_ID=

# Offline rehearsal (NOT Bedrock): a scripted stand-in model for UI rehearsal without AWS.
# Prefer `npm run dev:offline` over setting this here.
# UNRUSH_OFFLINE=1
