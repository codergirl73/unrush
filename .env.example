# Copy to .env and adjust. .env is gitignored - never commit credentials.

# ---- MCP server ----
MCP_PORT=3001
# SQLite file holding all long-term household state (gitignored)
UNRUSH_DB_PATH=./data/unrush.db
# Optional: pretend "now" is this local time so the demo works at any hour.
# "HH:MM" (today) or "YYYY-MM-DDTHH:MM". The clock keeps ticking from there.
# UNRUSH_NOW=15:00
