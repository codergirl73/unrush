{
  "name": "@unrush/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev:server": "tsx watch --env-file-if-exists=../../.env server/index.ts",
    "dev:ui": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=../../.env server/index.ts",
    "chat": "tsx --env-file-if-exists=../../.env server/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . && tsc -p src",
    "agentcore:setup": "tsx --env-file-if-exists=../../.env server/agentcore-setup.ts",
    "agentcore:reset": "tsx --env-file-if-exists=../../.env server/agentcore-reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1152.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1152.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.4"
  }
}
